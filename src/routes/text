 SIDEBAR
  <div class="rounded-tl-[20px] rounded-bl-[20px]
              px-[20px] py-[40px] text-white col-span-2 h-full 
              bg-black/19 border-r border-white/10 
              flex flex-col gap-3">

    <div class="grid grid-rows-3 gap-3 px-3">
      <div class="p-2 border border-white/20 flex items-center gap-4 bg-black/40 rounded-xl">
        <div class="flex p-2 items-center justify-center bg-white/24 rounded-full">
          <Fa icon={faPlus} class="text-2xl" />
        </div>
        <p class="font-poppins font-light text-[15px]">New Chat</p>
      </div>

      <div class="p-4 border border-white/20 flex items-center justify-between gap-4  bg-black/40 rounded-xl">
        <p class="font-poppins font-light text-[15px] text-white/50">Search the chats</p>
        <Fa icon={faSearch} class="text-2xl" />
      </div>

      <div class="border-b border-white/20"></div>
    </div>

    <div>
      <p class="text-white/40 px-3 pb-4 font-poppins font-light text-[13px]">Last Chats</p>
      <div class="flex flex-col">
        {#each companies as name, index}
          <button
            class={`group flex items-center justify-between gap-4 rounded-xl transition-colors duration-200 cursor-pointer 
              ${activeIndex === index ? 'bg-black/40' : 'hover:bg-black/40'}`}
            on:click={() => activeIndex = index}
          >
            <p class="px-3 py-[13px] font-poppins font-light text-[15px] text-white">
              {name}
            </p>
            <div class={`mr-4 transition-opacity duration-300 
                ${activeIndex === index ? 'opacity-100' : 'group-hover:opacity-100 opacity-0'}`}>
              <Fa icon={faEllipsisH} class="text-white text-2xl" />
            </div>
          </button>
        {/each}
      </div>
    </div>
  </div>

