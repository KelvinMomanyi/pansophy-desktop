# Browser-side URL used by src/lib/chatApi.js.
VITE_OLLAMA_API_URL=http://127.0.0.1:11500

# Port used by the native Tauri health check and bundled Ollama sidecar.
PANSOPHY_OLLAMA_PORT=11500

